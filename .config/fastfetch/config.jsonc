{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " "
    },
    "logo": {
        "source": "~/.config/fastfetch/logo/logo.png",
        "height": 18,
        "padding": {
            "top": 4
        }
    },
    "modules": [
       "break",
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#36}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#33} font    {#keys}│",
            "type": "terminalfont"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#34}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#35} memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#36}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "│ {#33} gpu     {#keys}│",
            "type": "gpu",
            "format": "{1} {2} @ {12} GHz"
        },
        {
            "key": "│ {#34}󰓡 swap    {#keys}│",
            "type": "swap"
        },
        {
            "key": "│ {#35}󰋊 disk    {#keys}│",
            "type": "disk"
        },
        {
            "key": "│ {#32}󰀻 icons   {#keys}│",
            "type": "icons"
        },
        {
            "key": "│ {#33}󰉼 wmtheme {#keys}│",
            "type": "wmtheme"
        },
        {
            "key": "│ {#34} cursor  {#keys}│",
            "type": "cursor"
        },
        {
            "type": "battery",
            "key": "│ {#35} battery {#keys}│",
            "keycolor": "red"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}

