/* ===========================
   0) New file: common.rasi
   Put this in ~/.config/rofi/common.rasi
   =========================== */

configuration {
    modi:                       "drun,filebrowser,window,run";
    font:                       "Monolisa 12";
    show-icons:                 true;

    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        "";
    display-window:             "";

    drun-display-format:        "{name}";
    hover-select:               false;
    scroll-method:              1;

    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";

    window-format:              "{w} · {c} · {t}";
    auto-select:                false;
}

@import "default.rasi"

/* -------- Shared window defaults (most of your themes) -------- */
window {
    height:                     30em;
    width:                      46em;
    fullscreen:                 false;
    enabled:                    true;
    cursor:                     "default";
    spacing:                    0em;
    padding:                    0em;
    location:                   center;
    anchor:                     center;
    border:                     0.1em;
    border-radius:              1em;
    width:                      55%;
}

/* -------- Shared inputbar (arrow prompt + entry) -------- */
inputbar {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 white;
    margin:                     1em;
    children:                   [ "textbox-prompt-colon", "entry" ];
    border-radius:              1em;
    color:                      white;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "  ";
    padding:                    1em 0.3em 0 0;
    text-color:                 white;
    background-color:           transparent;
}

entry {
    enabled:                    true;
    spacing:                    1em;
    padding:                    1em;
    cursor:                     text;
    placeholder:                "";
    background-color:           transparent;
    placeholder-color:          inherit;
}

/* -------- Shared listview style (single column list) -------- */
listview {
    padding:                    1em;
    spacing:                    0.5em;
    enabled:                    true;
    columns:                    1;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    cursor:                     "default";
    background-color:           transparent;
}

element {
    enabled:                    true;
    spacing:                    0.2em;
    padding:                    0.5em;
    cursor:                     pointer;
    background-color:           transparent;
    text-color:                 white;
    border-radius:              1em;
}

element-icon {
    size:                       1.3em;
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
    border-radius:              0em;
}

element-text {
    vertical-align:             0.5;
    horizontal-align:           0.0;
    padding:                    0.5em;
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
}

error-message {
    background-color:           transparent;
    text-transform:             capitalize;
    children:                   [ "textbox" ];
}

textbox {
    text-color:                 inherit;
    background-color:           inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

