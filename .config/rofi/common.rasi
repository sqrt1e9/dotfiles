/* ===========================
   0) New file: common.rasi
   Put this in ~/.config/rofi/common.rasi
   =========================== */

configuration {
    modi:                       "drun,filebrowser,window,run";
    font:                       "FiraCode Nerd Font 12";
    show-icons:                 false;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name}";
    hover-select:               false;
    scroll-method:              1;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    auto-select:                false;
}

@import "default.rasi"

/* -------- Shared window defaults (most of your themes) -------- */
window {
    height:                     30em;
    width:                      36em;
    fullscreen:                 false;
    enabled:                    true;
    cursor:                     "default";
    spacing:                    0em;
    padding:                    0em;
    location:                   center;
    anchor:                     center;
    border:                     0.1em;
    border-radius:              0.1em;
}

/* -------- Shared inputbar (arrow prompt + entry) -------- */
inputbar {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @text;
    children:                   [ "textbox-prompt-colon", "entry" ];
    border-radius:              0.1em;
    color:                      white;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "";
    padding:                    1em 0 0.5em 0;
    text-color:                 @text;
    background-color:           transparent;
}

entry {
    enabled:                    true;
    padding:                    1em 0 0.5em 0;
    cursor:                     text;
    placeholder:                "Type to filter";
    background-color:           transparent;
    placeholder-color:          var(placeholder-color);
    text-color:                 @text;
}

/* -------- Shared listview style (single column list) -------- */
listbox {
    orientation:      horizontal;
    children:         [ "listview" ];
    background-color: transparent;
}

listview {
    padding:                    0em 0.1em;
    enabled:                    true;
    columns:                    1;
    lines:                      10;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    cursor:                     "default";
    background-color:           transparent;
}

element {
    enabled:                    true;
    cursor:                     pointer;
    background-color:           transparent;
    text-color:                 @text;
    border-radius:              0.1em;
}

element-icon {
    enabled:                    false;
    size:                       1.3em;
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 @text;
}

element-text {
    vertical-align:             0.5;
    horizontal-align:           0.0;
    padding:                    0.3em;
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
}

error-message {
    background-color:           transparent;
    text-transform:             capitalize;
    children:                   [ "textbox" ];
}

textbox {
    text-color:                 @text;
    background-color:           inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

