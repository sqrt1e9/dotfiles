@import "common.rasi"

configuration {
    font: "Monolisa 12";
    show-icons: false;
    me-accept-entry: "MousePrimary";
}

mainbox {
    enabled:          true;
    orientation:      vertical;
    spacing:          0em;
    padding:          0em 0.5em;
    children:         [ "inputbar", "message", "listview" ];
    background-color: white / 14%;
}

message {
    enabled:          true;
    background-color: black / 10%;
    margin:           0.5em 0em 0.5em 0em;
    padding:          0.5em 1em;
    text-color:       #ffffff;
    border-radius:    0.5em;
}

textbox {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          0em;     /* no padding change */
}

/* (rest of your file unchanged) */
inputbar {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 white;
    children:                   [ "textbox-prompt-colon", "entry" ];
    border-radius:              0.5em;
    color:                      white;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "➤ ";
    padding:                    1em 0 0.5em 0;
    text-color:                 white;
    background-color:           transparent;
    font:                       "Monolisa Bold 12";
}

entry {
    enabled:                    true;
    padding:                    1em 0 0.5em 0;
    cursor:                     text;
    placeholder:                "";
    background-color:           transparent;
    placeholder-color:          inherit;
}

listview {
    enabled:          true;
    padding:          0em 0.5em;
    spacing:          0.5em;
    columns:          7;
    lines:            7;
    fixed-columns:    true;
    fixed-height:     true;
    layout:           vertical;
    scrollbar:        false;
    background-color: transparent;
    expand:           false;
}

element {
    cursor:        pointer;
    padding:       0.5em 0.8em;
    min-width:     4.4em;
}

element selected {
    background-color: @shade-bg;
    text-color:       @text;
}

element.normal {
    text-color: white / 80%;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          0.2em;
}

element-icon {
    font: "Symbols Nerd Font 16";
}

