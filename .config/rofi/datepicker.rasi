/* ===========================
   7) datepicker.rasi (updated)
   (Keep separate; it diverges a lot)
   =========================== */

@import "common.rasi"

configuration {
    /* If rofi ignores comma fallbacks, keep primary font sane here */
    font: "Monolisa 12";
    show-icons: false;
    me-accept-entry: "MousePrimary";
}

window {
    height:        28em;
    width:         30em;
    border:        0.1em;
    border-radius: 1em;
}

/* Datepicker layout differs: vertical */
mainbox {
    enabled:          true;
    orientation:      vertical;
    spacing:          0em;
    padding:          0em;
    children:         [ "inputbar", "listview" ];
    background-color: white / 14%;
}

inputbar {
    margin: 1em 1em 0em 1em;
    children: [ "textbox-prompt-colon", "prompt", "entry" ];
}

/* Calendar icon */
textbox-prompt-colon {
    str: "   ";
    /* if glyphs are tiny in rofi, make this bigger explicitly */
    font: "Symbols Nerd Font 18";
}

/* Month/Year label */
prompt {
    enabled:          true;
    expand:           false;
    min-width:        12em;
    padding:          1em 0.25em 0 0;
    background-color: transparent;
    text-color:       white;
    font:             "Monolisa Bold 12";
}

/* Calendar grid */
listview {
    enabled:          true;
    padding:          1.5em 1em;
    spacing:          0.6em;
    columns:          7;
    lines:            7;
    fixed-columns:    true;
    fixed-height:     true;
    layout:           vertical;
    scrollbar:        false;
    background-color: transparent;
    width:            20em;
}

element {
    cursor:        pointer;
    padding:       0.5em 0.8em;
    min-width:     4.4em;
    border-radius: 1em;
}

element selected {
    background-color: @shade-bg;
    text-color:       @text;
}

element.normal {
    text-color: white / 80%;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          0.2em;
}

/* Make the per-cell icon font larger, if you use icons there */
element-icon {
    font: "Symbols Nerd Font 16";
}

