/* ===========================
   7) datepicker.rasi (updated)
   (Keep separate; it diverges a lot)
   =========================== */

@import "common.rasi"

window {
    width: 30em;
    height: 25em;
}

configuration {
    /* If rofi ignores comma fallbacks, keep primary font sane here */
    font: "Monolisa 12";
    show-icons: false;
    me-accept-entry: "MousePrimary";
}

mainbox {
    enabled:          true;
    orientation:      vertical;
    spacing:          0em;
    padding:          0.5em;
    children:         [ "inputbar", "listview" ];
    background-color: white / 14%;
}

inputbar {
    children: [ "textbox-prompt-colon", "prompt", "entry" ];
}

/* Textbox for month-year placeholder */
textbox {
    text-color: #888888;   /* light gray */
    font: "Monolisa Bold 12";
    padding: 0.25em 0.5em;
    background-color: transparent;
}

entry {
    enabled:                    true;
    padding:                    1em 0 0.5em 0;
    cursor:                     text;
    background-color:           transparent;
    placeholder-color:          #888888;
}

/* Calendar icon */
textbox-prompt-colon {
    str: "";
    font: "Symbols Nerd Font 12";
}

/* Month/Year label */
prompt {
    enabled:          true;
    expand:           false;
    min-width:        12em;
    padding:          1em 0.25em 0 0;
    background-color: transparent;
    text-color:       white;
    font:             "Monolisa Bold 12";
}

/* Calendar grid */
listview {
    enabled:          true;
    padding:                    0em 0.5em;
    spacing:                    0.5em;
    columns:          7;
    lines:            7;
    fixed-columns:    true;
    fixed-height:     true;
    layout:           vertical;
    scrollbar:        false;
    background-color: transparent;
}

element {
    cursor:        pointer;
    padding:       0.5em 0.8em;
    min-width:     4.4em;
}

element selected {
    background-color: @shade-bg;
    text-color:       @text;
}

element.normal {
    text-color: white / 80%;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          0.2em;
}

/* Make the per-cell icon font larger, if you use icons there */
element-icon {
    font: "Symbols Nerd Font 16";
}

