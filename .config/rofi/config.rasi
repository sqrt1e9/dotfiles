/* ===========================
   config.rasi (FULL, MODIFIED)
   =========================== */

@import "common.rasi"

configuration {
    show-icons: true;
    me-accept-entry: "MousePrimary";
    window-format: "{w} · {c} · {t}";
}

mainbox {
    enabled:          true;
    spacing:          0em;
    padding:          0em;
    orientation:      horizontal;
    children:         [ "imagebox" ];
    background-color: white / 14%;
}

imagebox {
    padding:          0.5em;
    background-color: white / 5%;
    orientation:      vertical;
    children:         [ "inputbar", "listview", "mode-switcher" ];
}

/* make listview take remaining space */
listview {
    expand:           true;
}

inputbar {
    children: [ "textbox-prompt-colon", "entry" ];
}

/* ===========================
   Bottom row (50 / 50 split, compact)
   =========================== */
bottomrow {
    orientation:      horizontal;
    expand:           false;        /* prevent stealing height */
    height:           2.2em;        /* tune if needed */
    spacing:          0em;
    padding:          0em;
    margin:           0.25em 0em 0em 0em;
    children:         [ "leftslot", "rightslot" ];
    background-color: transparent;
}

/* LEFT 50% */
leftslot {
    orientation:      horizontal;
    expand:           true;         /* 50% */
    padding:          0em;
    children:         [ "mode-switcher" ];
    background-color: transparent;
}

/* RIGHT 50% (empty) */
rightslot {
    orientation:      horizontal;
    expand:           true;         /* 50% */
    padding:          0em;
    background-color: transparent;
}

/* ===========================
   Mode switcher (compact)
   =========================== */
mode-switcher {
    orientation:      horizontal;
    enabled:          true;
    expand:           false;
    padding:          0.2em;
    spacing:          1em;
    background-color: transparent;
    border-radius:    0.5em;
}

button { 
    padding: 0.5em 1.8em; 
    border: 0; 
    cursor: pointer; 
    background-color: black / 10%; 
    text-color: @text; 
    border-radius: 0.5em;
}

button selected {
    padding:          0.18em 0.40em;
    background-color: @shade-bg;
    text-color:       @text;
}

