/* ===========================
   config.rasi (FULL, MODIFIED)
   =========================== */

@import "common.rasi"

configuration {
    show-icons: true;
    me-accept-entry: "MousePrimary";
    window-format: "{w} · {c} · {t}";
}

mainbox {
    enabled:          true;
    spacing:          0em;
    padding:          0em;
    orientation:      horizontal;
    children:         [ "imagebox" ];
    background-color: white / 14%;
}

imagebox {
    padding:          0em 0.5em;
    background-color: white / 5%;
    orientation:      vertical;
    children:         [ "inputbar", "listview", "mode-switcher" ];
}

/* make listview take remaining space */
listview {
    expand:           true;
}

inputbar {
    children: [ "textbox-prompt-colon", "entry" ];
}

mode-switcher {
    orientation:      horizontal;
    enabled:          true;
    expand:           false;
    padding:          0.5em;
    spacing:          1em;
    background-color: transparent;
    border-radius:    0.5em;
}

button { 
    padding: 0.5em 1.8em; 
    border: 0; 
    cursor: pointer; 
    background-color: black / 10%; 
    text-color: @text; 
    border-radius: 0.5em;
}

button selected {
    padding:          0.18em 0.40em;
    background-color: @shade-bg;
    text-color:       @text;
}

