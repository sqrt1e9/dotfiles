/* ===========================
   2) todo.rasi (updated)
   (Same layout as config.rasi — keep as thin wrapper)
   =========================== */

@import "config.rasi"

imagebox {
    padding:          0em 0.5em;
    background-color: @crust;
    orientation:      vertical;
    children:         [ "inputbar", "listbox", "message" ];
}

message {
    enabled:          true;
    background-color: black / 10%;
    margin:           0.5em 0em 0.5em 0em;
    padding:          0.5em 1em;
    text-color:       @text;
    border-radius:    0.5em;
}

textbox {
    background-color: transparent;
    text-color:       @text;
    horizontal-align: 0.0;
}


