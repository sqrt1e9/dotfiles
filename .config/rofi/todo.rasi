/* ===========================
   2) todo.rasi (updated)
   (Same layout as config.rasi — keep as thin wrapper)
   =========================== */

@import "config.rasi"

imagebox {
    padding:          0.5em;
    background-color: white / 5%;
    border-radius:    1em;
    orientation:      vertical;

    /* keep the layout from config.rasi and just add message under inputbar */
    children:         [ "inputbar", "message", "mode-switcher" ];
}

message {
    enabled:          true;
    background-color: transparent;
    margin:           15em 1em 0em 1em;
    padding:          0.5em 1em;
    text-color:       #ffffff;
}

textbox {
    background-color: transparent;
    text-color:       white;
    horizontal-align: 0.0;
}


