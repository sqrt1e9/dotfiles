/* ===========================
   3) todo_list.rasi (updated)
   Differences:
   - vertical mainbox
   - cursor defaults (your “CHANGED” comments)
   - kb bindings in configuration
   =========================== */

@import "common.rasi"

configuration {
    auto-select:          false;
    kb-accept-entry:      "Return,KP_Enter";
    kb-cancel:            "Escape";
    me-accept-entry:      "";   /* you had this empty */
}

mainbox {
    enabled:          true;
    padding:          0em;
    orientation:      vertical;
    children:         [ "imagebox" ];
    background-color: @crust;
}

imagebox {
    padding:          0em 0.5em;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "listbox" ];
}

listbox {
    padding:          0em;
    spacing:          0em;
    orientation:      horizontal;
    children:         [ "listview" ];
    background-color: transparent;
}

listview {
    padding:                    0.2em;
    spacing:                    0.5em;
    enabled:                    true;
    columns:                    1;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    cursor:                     "default";
    background-color:           transparent;
}

/* Overrides: cursor behavior for list selection */
element { cursor: default; }
element-icon { cursor: default; }
element-text { cursor: default; }

