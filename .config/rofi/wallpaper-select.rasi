/* wallpaper-select.rasi — matched to common.rasi sizing/padding */

@import "common.rasi"

configuration {
    modi:                       "drun,filebrowser,window,run";
    font:                       "Monolisa 11";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name}";
    hover-select:               false;
    scroll-method:              1;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    auto-select:                false;
}

window {
    height:                     33em;
    width:                      40em;
    fullscreen:                 false;
    enabled:                    true;
    cursor:                     "default";
    spacing:                    0em;
    padding:                    1em;
    location:                   center;
    anchor:                     center;
    border:                     0em;
    border-radius:              1.2em;
}

mainbox {
    spacing:                    0em;
    padding:                    0em;
    children:                   [ "imagebox" ];
    background-color:           transparent;
}

imagebox {
    padding:                    0em;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @text;
    children:                   [ "textbox-prompt-colon", "entry" ];
    border-radius:              0.8em;
    padding:                    0.35em 0.7em;
    color:                      @text;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "";
    padding:                    0.7em 0 0.7em 0;
    text-color:                 @text;
    background-color:           transparent;
}

entry {
    enabled:                    true;
    padding:                    0.7em 0 0.7em 0;
    cursor:                     text;
    placeholder:                "Search wallpapers";
    background-color:           transparent;
    placeholder-color:          var(placeholder-color);
    text-color:                 @text;
}

listview {
    padding:                    0.45em;
    spacing:                    0.25em;
    columns:                    3;
    fixed-columns:              true;
    lines:                      3;
    fixed-height:               true;
    dynamic:                    true;
    cycle:                      false;
    scrollbar:                  false;
    layout:                     vertical;
    background-color:           transparent;
}

element {
    spacing:                    0.05em;
    cursor:                     pointer;
    background-color:           @shade-bg;
    text-color:                 @text;
    orientation:                vertical;
    border-radius:              0.75em;
    padding:                    0.05em;
}

element normal.active,
element alternate.active {
    background-color:           @hover-bg;
    text-color:                 #7287FD;
    border-radius:              0.75em;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color:           @select-bg;
    text-color:                 @text-selected;
    border-radius:              0.75em;
    padding:                    0.05em;
}

element-icon {
    enabled:                    true;
    size:                       6em;
    background-color:           transparent;
    text-color:                 inherit;
}

element-text {
    enabled:                    false;
}

error-message {
    background-color:           transparent;
    text-transform:             capitalize;
}
