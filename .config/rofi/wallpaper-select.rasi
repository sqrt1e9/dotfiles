/* ===========================
   6) wallpaper-select.rasi (updated)
   (Grid layout – overrides listview/element styles heavily)
   =========================== */

@import "common.rasi"

window {
    height:        35em;
    width:         55%;
    border:        0.1em;
    padding:       0em;
    spacing:       0em;
    location:      center;
    anchor:        center;
}

/* Override main layout */
mainbox {
    spacing:          0em;
    padding:          0em;
    children:         [ "inputbar", "listview" ];
    background-color: white / 14%;
}

/* Grid listview */
listview {
    padding:        1em;
    spacing:        1em;

    columns:        3;
    fixed-columns:  true;
    lines:          3;
    fixed-height:   true;

    dynamic:        true;
    cycle:          false;
    scrollbar:      false;
    layout:         vertical;
    background-color: transparent;
}

element {
    padding:          0.5em;
    spacing:          0.4em;
    cursor:           pointer;
    background-color: @shade-bg;
    text-color:       @text;
    orientation:      vertical;
}

element selected {
    background-color: @shade-bg;
    text-color:       @text;
}

element-icon {
    size:            10em;
    background-color: transparent;
    text-color:      inherit;
}

element-text {
    padding:          0.2em;
    background-color: transparent;
    text-color:       @text;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    font:             "Monolisa 12";
}

error-message {
    background-color: transparent;
    text-transform:   capitalize;
}

