/* ~/.config/rofi/default.rasi (Mocha hover + selection only) */

* {
	/* Mocha core */
	text:			#CDD6F4;
	foreground:		#CDD6F4;

	/* Keep your existing glass language */
	shade-shadow:	white / 6%;
	shade-border:	white / 24%;
	border-color:	white / 10%;

	/* ONLY: hover + selection (solid, because your rofi build rejects alpha for hex/vars) */
	hover-bg:		#89B4FA;	/* Mocha blue */
	select-bg:		#B4BEFE;	/* Mocha lavender */
	select-border:	#B4BEFE;	/* Mocha lavender */

	/* Preserve your existing tokens */
	shade-bg:		white / 12%;
	background-alt:	@shade-bg;
	selected:		@shade-bg;

	active:			@hover-bg;
	urgent:			@hover-bg;

	selected-normal-background:	@shade-bg;
	selected-active-background:	@shade-bg;
	selected-urgent-background:	@shade-bg;

	text-selected:	#11111B;
    crust:          #11111B;
}

window {
	fullscreen:			false;
	transparency:		"real";
	cursor:				"default";

	/* Liquid glass (restore your original) */
	background-color:	@crust;

	border:				0em;
	border-color:		@border-color;
}

/* Elements ----------------------------------------------------- */
element normal.normal,
element alternate.normal {
	background-color:	transparent;
	text-color:			@text;
}

/* Hover */
element normal.active,
element alternate.active {
	background-color:	@hover-bg;
	text-color:			@text-selected;
	border:				0.0625em solid;
	border-color:		@select-border;
}

/* Selected */
element selected.normal {
	background-color:	@select-bg;
	text-color:			@text-selected;
	border:				0.0625em solid;
	border-color:		@select-border;
}

element-text {
	background-color:	transparent;
	text-color:			inherit;
	highlight:			inherit;
	cursor:				inherit;
	vertical-align:		0.5;
	horizontal-align:	0.5;
}

/* Listview ---------------------------------------------------- */
listview {
	border:				0em;
}

/* Scrollbar ---------------------------------------------------- */
scrollbar {
	margin:				0 0.25em;
	handle-width:		0.5em;
	handle-color:		white;
	background-color:	@shade-shadow;
}

/* Message ------------------------------------------------------ */
message {
	/* Liquid glass (restore your original style) */
	background-color:	@crust;
	border:				0.0625em solid;
	border-color:		transparent;
	padding:			1.5em;
}

error-message {
	padding:			6.25em;
	border:				0em solid;
	background-color:	@crust;
	text-color:			@text;
}

textbox {
	background-color:	transparent;
	text-color:			@text;
	vertical-align:		0.5;
	horizontal-align:	0.5;
	highlight:			none;
}

