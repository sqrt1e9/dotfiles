/* ~/.config/rofi/default.rasi — macOS Light + Catppuccin Latte Lavender */

* {
    text:                       #4C4F69;
    foreground:                 #4C4F69;
    subtext:                    #6C6F85;

    pill:                       white / 82%;
    pill-soft:                  white / 68%;

    lavender:                   #7287FD;
    lavender-soft:              #E7E9FF;

    hover-bg:                   @lavender-soft;
    select-bg:                  @lavender;

    text-selected:              #FFFFFF;
    placeholder-color:          #6C6F85;

    background-alt:             @pill;
    selected:                   @select-bg;

    active:                     @hover-bg;
    urgent:                     @hover-bg;

    selected-normal-background: @select-bg;
    selected-active-background: @select-bg;
    selected-urgent-background: @select-bg;
}

window {
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    background-color:           @pill;
    border:                     0em;
    border-radius:              1.2em;
    padding:                    1em;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @text;
    border-radius:              0.75em;
    padding:                    0.6em 1em;
    margin:                     0.1em 0;
}

element normal.active,
element alternate.active {
    background-color:           @hover-bg;
    text-color:                 @lavender;
    border:                     0em;
    border-radius:              0.75em;
    padding:                    0.6em 1em;
    margin:                     0.1em 0;
}

element selected.normal {
    background-color:           @select-bg;
    text-color:                 @text-selected;
    border:                     0em;
    border-radius:              0.75em;
    padding:                    0.6em 1em;
    margin:                     0.1em 0;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    padding:                    0.1em 0.25em;
}

listview {
    border:                     0em;
    padding:                    0.45em;
    spacing:                    0.25em;
}

scrollbar {
    margin:                     0 0.25em;
    handle-width:               0.5em;
    handle-color:               @lavender;
    background-color:           transparent;
}

message {
    background-color:           @pill-soft;
    border:                     0em;
    border-radius:              0.8em;
    padding:                    1em;
}

error-message {
    padding:                    6.25em;
    border:                     0em;
    background-color:           @pill;
    text-color:                 @text;
    border-radius:              1.2em;
}

textbox {
    background-color:           transparent;
    text-color:                 @text;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    highlight:                  none;
}
