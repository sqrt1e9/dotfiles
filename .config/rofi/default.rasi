@import "~/.config/theme/current.rasi"

* {
    text:                       #4C4F69;
    foreground:                 #4C4F69;
    subtext:                    #6C6F85;

    pill:                       white/85%;
    pill-soft:                  white/68%;

    hover-bg:                   @accent-soft;
    select-bg:                  @accent;

    text-selected:              #FFFFFF;
    placeholder-color:          #6C6F85;

    background-alt:             @pill;
    selected:                   @select-bg;

    active:                     @hover-bg;
    urgent:                     @hover-bg;

    selected-normal-background: @select-bg;
    selected-active-background: @select-bg;
    selected-urgent-background: @select-bg;

    padding:                    0;
    spacing:                    0;
    border:                     0;
}

window {
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    background-color:           @pill;

    border:                     0;
    border-radius:              1.2em;

    padding:                    0;
}

mainbox {
    background-color:           transparent;
    spacing:                    0;
}

inputbar {
    text-color:                 @foreground;

    padding:                    12px 12px 4px 12px;

    children:                   [ prompt, textbox-prompt-colon, entry, num-filtered-rows, textbox-num-sep, num-rows ];

    background-color:           transparent;
}

listview {
    border:                     0;

    padding:                    2px 0 8px 0;

    spacing:                    0;

    fixed-height:               true;
    lines:                      12;
    scrollbar:                  false;

    background-color:           transparent;
}

element {
    padding:                    3px 12px;
    spacing:                    6px;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @text;
}

element normal.active,
element alternate.active {
    background-color:           @hover-bg;
    text-color:                 @accent;
}

element selected.normal {
    background-color:           @select-bg;
    text-color:                 @text-selected;
    border-radius:              1.2em;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    padding:                    0;
}

element-icon {
    background-color:           transparent;
    size:                       1em;
    margin:                     0 4px 0 0;
}

scrollbar {
    handle-color:               @accent;
    width:                      4px;
    handle-width:               8px;
}

message {
    background-color:           @pill-soft;
    padding:                    2px 12px;
}

error-message {
    background-color:           transparent;
    padding:                    2px 12px;
}

textbox {
    background-color:           transparent;
    text-color:                 @text;
}

prompt {
    text-color:                 inherit;
    background-color:           transparent;
}

textbox-prompt-colon {
    text-color:                 inherit;
    margin:                     0 6px 0 0;
    expand:                     false;
    str:                        ":";
    background-color:           transparent;
}

entry {
    text-color:                 inherit;
    placeholder-color:          @placeholder-color;
    placeholder:                "Type to filter";
    background-color:           transparent;
}

num-filtered-rows,
num-rows,
textbox-num-sep {
    text-color:                 inherit;
    expand:                     false;
    background-color:           transparent;
}

textbox-num-sep {
    str:                        "/";
}
